APP_ENV=development
APP_NAME=AISHA
APP_URL=http://localhost:8088
API_PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SIGNING_KEY=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgres://aisha:replace-me@postgres:5432/aisha?sslmode=disable
TEST_DATABASE_URL=postgres://aisha:replace-me@postgres:5432/aisha_migration_test?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=aisha
MINIO_ROOT_PASSWORD=replace-me-too
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aisha
MINIO_SECRET_KEY=replace-me-too
MINIO_USE_SSL=false
MINIO_PUBLIC_BUCKET=product-public
MINIO_PRIVATE_BUCKET=product-private
MINIO_ARTISAN_BUCKET=artisan-private
API_BASE_URL=http://api:8080/api/v1
